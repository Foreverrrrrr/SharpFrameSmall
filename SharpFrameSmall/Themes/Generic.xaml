    <DrawingBrush
        x:Key="CheckerboardBrush"
        TileMode="Tile"
        Viewport="0,0,45,45"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,45,45" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Black">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,22.5,22.5" />
                            <RectangleGeometry Rect="22.5,22.5,22.5,22.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="{x:Type local:DisplayVision}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DisplayVision}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Background="{TemplateBinding TitleBackground}"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock
                                    Margin="10,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#333333"
                                    Text="{TemplateBinding Title}"
                                    TextAlignment="Center" />
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="1"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{TemplateBinding SaveImageCommand}"
                                        Foreground="#FFFAFAFA"
                                        ToolTip="Save">
                                        <materialDesign:PackIcon Kind="ContentSave" />
                                    </Button>
                                    <Button
                                        Margin="1"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{TemplateBinding ResetSizeCommand}"
                                        Foreground="#FFFAFAFA"
                                        ToolTip="Reset">
                                        <materialDesign:PackIcon Kind="CropFree" />
                                    </Button>
                                    <Border
                                        Width="1"
                                        Margin="5,3"
                                        Background="#66FFFFFF" />
                                    <RadioButton
                                        Margin="1"
                                        IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=None}"
                                        Style="{StaticResource MaterialDesignToolRadioButton}"
                                        ToolTip="选择/浏览模式">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="CursorDefault" />
                                    </RadioButton>
                                    <Border
                                        Width="1"
                                        Margin="5,3"
                                        Background="#66FFFFFF" />

                                    <Button
                                        Margin="1"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{Binding ApplyRoiCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="#FF4CE807"
                                        ToolTip="应用/保存ROI">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="Check" />
                                    </Button>
                                    <Button
                                        Margin="1"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{Binding ClearRoiCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="#FFFF6B6B"
                                        ToolTip="清除所有ROI">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="Close" />
                                    </Button>
                                    <Button
                                        Margin="1"
                                        Background="{x:Null}"
                                        BorderBrush="{x:Null}"
                                        Command="{TemplateBinding ClearShapesCommand}"
                                        Foreground="#FFFFAA00"
                                        ToolTip="清除所有图形"
                                        Visibility="{Binding IsDrawingEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="Eraser" />
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <Grid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <Canvas
                                        x:Name="ImageCanvas"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="{StaticResource CheckerboardBrush}">
                                        <Image
                                            x:Name="OriginalImageControl"
                                            Width="Auto"
                                            Height="Auto"
                                            Source="{Binding InputImage, RelativeSource={RelativeSource TemplatedParent}}"
                                            Stretch="None" />
                                        <Rectangle
                                            x:Name="SelectionRectangle"
                                            Stroke="Red"
                                            StrokeThickness="1"
                                            Visibility="Collapsed">
                                            <Rectangle.Fill>
                                                <SolidColorBrush Opacity="0.3" Color="Red" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Canvas>
                                </ScrollViewer>

                                <Border
                                    Margin="5"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    Background="#FF424242"
                                    CornerRadius="5"
                                    Opacity="0.7"
                                    Visibility="{Binding IsDrawingEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Rectangle}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制矩形/ROI">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="RectangleOutline" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Line}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制直线">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="VectorLine" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Circle}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制圆形">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="CircleOutline" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Ellipse}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制椭圆">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="EllipseOutline" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Arrow}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制箭头">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="ArrowTopRight" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Crosshair}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="放置十字准星">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="Crosshairs" />
                                        </RadioButton>
                                        <RadioButton
                                            Margin="1"
                                            IsChecked="{Binding CurrentDrawingMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DrawingModeConverter}, ConverterParameter=Polygon}"
                                            Style="{StaticResource MaterialDesignToolRadioButton}"
                                            ToolTip="绘制多边形">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="HexagonOutline" />
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Margin="10"
                                    Padding="5,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#80000000"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="Yellow"
                                    Opacity="1.0"
                                    Text="{TemplateBinding BottomRightText}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect
                                            BlurRadius="2"
                                            Direction="315"
                                            Opacity="0.8"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ParameterDataGrid}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ParameterDataGrid}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Border.Resources>
                            <local:BindingProxy x:Key="EditModeProxy" Data="{Binding EditMode, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题栏  -->
                            <Border
                                Grid.Row="0"
                                Padding="10,6"
                                Background="#FF424242"
                                CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFAFAFA"
                                        Text="{TemplateBinding Title}" />
                                    <!--  保存按钮  -->
                                    <Button
                                        x:Name="SaveButton"
                                        Grid.Column="1"
                                        Padding="8,3"
                                        Background="#FF1976D2"
                                        BorderBrush="Transparent"
                                        Command="{Binding InternalSaveCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Cursor="Hand"
                                        Foreground="White"
                                        ToolTip="保存参数">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Kind="ContentSave" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Text="保存" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!--  主数据表格（使用 SafeDataGrid 防止绑定错误）  -->
                            <local:SafeDataGrid
                                x:Name="PART_DataGrid"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                Background="#FF303030"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                ColumnHeaderHeight="32"
                                EnableColumnVirtualization="False"
                                EnableRowVirtualization="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                HorizontalGridLinesBrush="#FF555555"
                                IsReadOnly="{TemplateBinding IsContentEditable,
                                                             Converter={StaticResource InvertBoolConverter}}"
                                ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                RowBackground="#FF303030"
                                RowHeaderWidth="0"
                                ScrollViewer.CanContentScroll="False"
                                SelectionMode="Single">

                                <!--  DataGrid 资源  -->
                                <local:SafeDataGrid.Resources>
                                    <!--  列头样式  -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#FF424242" />
                                        <Setter Property="Foreground" Value="#FFFAFAFA" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="BorderBrush" Value="#FF555555" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                    <!--  单元格内 TextBlock 默认样式（显示模式）  -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFDEDEDE" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <!--  单元格内 TextBox 默认样式（编辑模式）  -->
                                    <Style x:Key="{x:Type TextBox}" TargetType="TextBox">
                                        <Setter Property="Background" Value="#FF2A2A2A" />
                                        <Setter Property="Foreground" Value="#FFDEDEDE" />
                                        <Setter Property="CaretBrush" Value="#FFDEDEDE" />
                                        <Setter Property="BorderBrush" Value="#FF1976D2" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="SelectionBrush" Value="#FF1976D2" />
                                    </Style>
                                    <!--  单元格样式  -->
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#FFDEDEDE" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border
                                                        x:Name="CellBorder"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        TextElement.Foreground="#FFDEDEDE">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#FF1976D2" />
                                                            <Setter TargetName="CellBorder" Property="TextElement.Foreground" Value="White" />
                                                        </Trigger>
                                                        <Trigger Property="IsEditing" Value="True">
                                                            <Setter Property="Background" Value="#FF2A2A2A" />
                                                            <Setter TargetName="CellBorder" Property="TextElement.Foreground" Value="#FFDEDEDE" />
                                                            <Setter Property="Padding" Value="0" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True" />
                                                                <Condition Property="IsEditing" Value="True" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Background" Value="#FF2A2A2A" />
                                                            <Setter TargetName="CellBorder" Property="TextElement.Foreground" Value="#FFDEDEDE" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!--  行样式（不设 Foreground/BorderBrush，避免 WPF 在 Cell 上创建 FindAncestor 绑定）  -->
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#FF303030" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF3E3E3E" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FF1565C0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:SafeDataGrid.Resources>

                                <!--  右键菜单  -->
                                <local:SafeDataGrid.ContextMenu>
                                    <ContextMenu
                                        Background="#FF424242"
                                        Foreground="#FFFAFAFA"
                                        Visibility="{Binding Data, Source={StaticResource EditModeProxy}, Converter={StaticResource EditModeToVisibilityConverter}}">
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ParameterAddForwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="向前添加">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Foreground="#FF4CAF50" Kind="PlusCircleOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ParameterAddBackwardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="向后添加">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Foreground="#FF4CAF50" Kind="PlusCircle" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#FF555555" />
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ParameterSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="排序">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Foreground="#FF2196F3" Kind="SortNumericAscending" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#FF555555" />
                                        <MenuItem
                                            Command="{Binding PlacementTarget.Tag.ParameterRemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            Header="删除">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Foreground="#FFEF5350" Kind="DeleteOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </local:SafeDataGrid.ContextMenu>

                                <!--  列定义  -->
                                <local:SafeDataGrid.Columns>
                                    <!--  ID 列  -->
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding ID}"
                                        Header="ID"
                                        IsReadOnly="True" />

                                    <!--  名称列  -->
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="参数名称"
                                        IsReadOnly="{Binding Data, Source={StaticResource EditModeProxy}, Converter={StaticResource EditModeToReadOnlyConverter}}" />

                                    <!--  描述列  -->
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Description}"
                                        Header="描述"
                                        IsReadOnly="{Binding Data, Source={StaticResource EditModeProxy}, Converter={StaticResource EditModeToReadOnlyConverter}}" />

                                    <!--  字段数量列  -->
                                    <DataGridTemplateColumn
                                        Width="80"
                                        Header="字段数"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MinWidth="28"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    Background="#FF1976D2"
                                                    CornerRadius="10">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding FieldCount}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  展开/折叠按钮列  -->
                                    <DataGridTemplateColumn Width="40" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    x:Name="ExpandToggle"
                                                    Width="24"
                                                    Height="24"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Cursor="Hand"
                                                    IsChecked="False"
                                                    ToolTip="展开/折叠字段详情">
                                                    <materialDesign:PackIcon
                                                        x:Name="ExpandIcon"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="#FFAAAAAA"
                                                        Kind="ChevronRight" />
                                                </ToggleButton>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ExpandToggle}" Value="True">
                                                        <Setter TargetName="ExpandIcon" Property="Kind" Value="ChevronDown" />
                                                        <Setter TargetName="ExpandIcon" Property="Foreground" Value="#FF64B5F6" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </local:SafeDataGrid.Columns>

                                <!--  行详情模板（展开后显示字段列表）  -->
                                <local:SafeDataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,2"
                                            Padding="10"
                                            Background="#FF262626"
                                            BorderBrush="#FF1976D2"
                                            BorderThickness="2,0,0,0">
                                            <StackPanel>
                                                <!--  字段标题  -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF64B5F6">
                                                        <Run Text="字段列表 (" />
                                                        <Run Text="{Binding FieldCount, Mode=OneWay}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                    <Button
                                                        x:Name="AddFieldButton"
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        Background="#FF388E3C"
                                                        BorderBrush="Transparent"
                                                        Cursor="Hand"
                                                        Foreground="White"
                                                        ToolTip="添加新字段"
                                                        Visibility="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Kind="Plus" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Text="添加字段" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!--  字段列表表头  -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,4,0"
                                                        Padding="4,2"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFAAAAAA"
                                                        Text="字段名称" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        Padding="4,2"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFAAAAAA"
                                                        Text="字段类型" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="0,0,4,0"
                                                        Padding="4,2"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFAAAAAA"
                                                        Text="字段值" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="0,0,4,0"
                                                        Padding="4,2"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFAAAAAA"
                                                        Text="单位" />
                                                </Grid>

                                                <!--  字段列表  -->
                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                x:Name="FieldRowBorder"
                                                                Margin="0,1"
                                                                Padding="6,4"
                                                                Background="#FF333333"
                                                                CornerRadius="3">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="120" />
                                                                            <ColumnDefinition Width="100" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="60" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!--  字段名  -->
                                                                        <TextBox
                                                                            Grid.Column="0"
                                                                            Margin="0,0,4,0"
                                                                            Padding="4,2"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="#FF2A2A2A"
                                                                            BorderBrush="#FF555555"
                                                                            CaretBrush="#FFDEDEDE"
                                                                            FontSize="11"
                                                                            Foreground="#FFDEDEDE"
                                                                            IsReadOnly="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToReadOnlyConverter}}"
                                                                            Text="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" />

                                                                        <!--  类型选择  -->
                                                                        <ComboBox
                                                                            Grid.Column="1"
                                                                            Margin="0,0,4,0"
                                                                            Padding="4,2"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="#FF2A2A2A"
                                                                            BorderBrush="#FF555555"
                                                                            FontSize="11"
                                                                            Foreground="#FFDEDEDE"
                                                                            IsEnabled="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToReadOnlyConverter}, ConverterParameter=Invert}"
                                                                            SelectedIndex="{Binding SelectedValue}">
                                                                            <ComboBox.Resources>
                                                                                <!--  下拉弹出框背景  -->
                                                                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2A2A2A" />
                                                                                <!--  选中项高亮背景  -->
                                                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF1976D2" />
                                                                                <!--  选中项高亮文字  -->
                                                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                                                                <!--  非焦点选中项  -->
                                                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF1976D2" />
                                                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                                                                            </ComboBox.Resources>
                                                                            <ComboBox.ItemContainerStyle>
                                                                                <Style TargetType="ComboBoxItem">
                                                                                    <Setter Property="Background" Value="#FF2A2A2A" />
                                                                                    <Setter Property="Foreground" Value="#FFDEDEDE" />
                                                                                    <Setter Property="Padding" Value="4,3" />
                                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                                    <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                            <ControlTemplate TargetType="ComboBoxItem">
                                                                                                <Border
                                                                                                    x:Name="Bd"
                                                                                                    Padding="{TemplateBinding Padding}"
                                                                                                    Background="{TemplateBinding Background}"
                                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                                    <ContentPresenter
                                                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                                                                                                </Border>
                                                                                                <ControlTemplate.Triggers>
                                                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                                                        <Setter TargetName="Bd" Property="Background" Value="#FF3E3E3E" />
                                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                                    </Trigger>
                                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                                        <Setter TargetName="Bd" Property="Background" Value="#FF1976D2" />
                                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                                    </Trigger>
                                                                                                </ControlTemplate.Triggers>
                                                                                            </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Style>
                                                                            </ComboBox.ItemContainerStyle>
                                                                            <ComboBoxItem Content="String" />
                                                                            <ComboBoxItem Content="Boolean" />
                                                                            <ComboBoxItem Content="Int32" />
                                                                            <ComboBoxItem Content="Single" />
                                                                            <ComboBoxItem Content="Double" />
                                                                        </ComboBox>

                                                                        <!--  值（带验证）  -->
                                                                        <TextBox
                                                                            x:Name="ValueTextBox"
                                                                            Grid.Column="2"
                                                                            Margin="0,0,4,0"
                                                                            Padding="4,2"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="#FF2A2A2A"
                                                                            CaretBrush="#FFDEDEDE"
                                                                            FontSize="11"
                                                                            Foreground="#FFDEDEDE"
                                                                            IsReadOnly="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToReadOnlyConverter}, ConverterParameter=ValueOnly}"
                                                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                            ToolTip="{Binding ValidationError}">
                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox">
                                                                                    <Setter Property="BorderBrush" Value="#FF555555" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                                            <Setter Property="BorderBrush" Value="#FFEF5350" />
                                                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBox.Style>
                                                                            <Validation.ErrorTemplate>
                                                                                <ControlTemplate>
                                                                                    <DockPanel>
                                                                                        <AdornedElementPlaceholder x:Name="placeholder" />
                                                                                        <materialDesign:PackIcon
                                                                                            Width="14"
                                                                                            Height="14"
                                                                                            Margin="-18,0,0,0"
                                                                                            VerticalAlignment="Center"
                                                                                            Foreground="#FFEF5350"
                                                                                            Kind="AlertCircle"
                                                                                            ToolTip="{Binding ElementName=placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
                                                                                    </DockPanel>
                                                                                </ControlTemplate>
                                                                            </Validation.ErrorTemplate>
                                                                        </TextBox>

                                                                        <!--  单位  -->
                                                                        <TextBox
                                                                            Grid.Column="3"
                                                                            Margin="0,0,4,0"
                                                                            Padding="4,2"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="#FF2A2A2A"
                                                                            BorderBrush="#FF555555"
                                                                            CaretBrush="#FFDEDEDE"
                                                                            FontSize="11"
                                                                            Foreground="#FF888888"
                                                                            IsReadOnly="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToReadOnlyConverter}}"
                                                                            Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                                                                        <!--  删除按钮  -->
                                                                        <Button
                                                                            x:Name="RemoveFieldButton"
                                                                            Grid.Column="4"
                                                                            Width="22"
                                                                            Height="22"
                                                                            Background="Transparent"
                                                                            BorderBrush="Transparent"
                                                                            Cursor="Hand"
                                                                            ToolTip="删除字段"
                                                                            Visibility="{Binding EditMode, RelativeSource={RelativeSource AncestorType=local:ParameterDataGrid}, Converter={StaticResource EditModeToVisibilityConverter}}">
                                                                            <materialDesign:PackIcon
                                                                                Width="14"
                                                                                Height="14"
                                                                                Foreground="#FFEF5350"
                                                                                Kind="Close" />
                                                                        </Button>
                                                                    </Grid>

                                                                    <!--  验证错误提示文字  -->
                                                                    <TextBlock
                                                                        x:Name="ErrorText"
                                                                        Margin="124,2,0,0"
                                                                        FontSize="10"
                                                                        Foreground="#FFEF5350"
                                                                        Text="{Binding ValidationError}"
                                                                        TextWrapping="Wrap"
                                                                        Visibility="Collapsed" />
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="FieldRowBorder" Property="Background" Value="#3FEF5350" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </local:SafeDataGrid.RowDetailsTemplate>

                                <!--  行详情默认折叠  -->
                                <local:SafeDataGrid.RowDetailsVisibilityMode>
                                    <x:Static Member="DataGridRowDetailsVisibilityMode.Collapsed" />
                                </local:SafeDataGrid.RowDetailsVisibilityMode>
                            </local:SafeDataGrid>

                            <!--  状态栏（保存反馈）  -->
                            <Border
                                x:Name="PART_StatusBar"
                                Grid.Row="2"
                                Padding="10,5"
                                Background="#FF2E7D32"
                                CornerRadius="0,0,4,4"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        x:Name="StatusIcon"
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="CheckCircle" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="White"
                                        Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        x:Name="DismissStatusButton"
                                        Grid.Column="2"
                                        Width="18"
                                        Height="18"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Cursor="Hand"
                                        ToolTip="关闭">
                                        <materialDesign:PackIcon
                                            Width="12"
                                            Height="12"
                                            Foreground="#CCFFFFFF"
                                            Kind="Close" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  状态栏触发器  -->
                    <ControlTemplate.Triggers>
                        <!--  失败时红色背景 + 错误图标  -->
                        <DataTrigger Binding="{Binding IsStatusSuccess, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter TargetName="PART_StatusBar" Property="Background" Value="#FFC62828" />
                            <Setter TargetName="StatusIcon" Property="Kind" Value="AlertCircle" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:AxisMonitor}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AxisMonitor}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid TextElement.FontSize="{TemplateBinding FontSize}">
                            <Grid.ColumnDefinitions>
                                <!--  左：轴列表DataGrid  -->
                                <ColumnDefinition Width="*" />
                                <!--  分隔线  -->
                                <ColumnDefinition Width="1" />
                                <!--  右：当前轴操作面板  -->
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <DataGrid
                                x:Name="PART_AxesDataGrid"
                                Grid.Column="0"
                                AutoGenerateColumns="False"
                                Background="#FF1E1E1E"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeRows="False"
                                CanUserSortColumns="True"
                                ColumnHeaderHeight="28"
                                EnableRowVirtualization="True"
                                FontSize="{TemplateBinding FontSize}"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                HorizontalGridLinesBrush="#FF2D2D2D"
                                ItemsSource="{TemplateBinding AxesSource}"
                                RowHeaderWidth="0"
                                RowHeight="26"
                                SelectionMode="Single"
                                SelectionUnit="FullRow">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#FF2D2D2D" />
                                        <Setter Property="Foreground" Value="#FF9E9E9E" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="BorderBrush" Value="#FF3A3A3A" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="#FFDEDEDE" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#FF1E1E1E" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF2A2A2A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FF1565C0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <!--  轴名  -->
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding AxisName}"
                                        Header="轴"
                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="8,0,0,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  脉冲位置  -->
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding PulsePosition, StringFormat=F3}"
                                        Header="指令位置"
                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="8,0,0,0" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="#FF64B5F6" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  编码器位置  -->
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding EncoderPosition, StringFormat=F3}"
                                        Header="编码器位置"
                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="8,0,0,0" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Setter Property="Foreground" Value="#FF80CBC4" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  使能状态  -->
                                    <DataGridTemplateColumn
                                        Width="50"
                                        Header="使能"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    Fill="{Binding IsServoOn, Converter={StaticResource ServoOnColorConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  轴状态  -->
                                    <DataGridTemplateColumn
                                        Width="60"
                                        Header="状态"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{Binding AxisStatus, Converter={StaticResource AxisStatusColorConverter}}"
                                                    Text="{Binding AxisStatus, Converter={StaticResource AxisStatusTextConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  限位状态 Origin / Lmt+ / Lmt-  -->
                                    <!--  原点  -->
                                    <DataGridTemplateColumn
                                        Width="44"
                                        Header="ORG"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF424242" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHomeSensor}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFEF5350" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  正限位  -->
                                    <DataGridTemplateColumn
                                        Width="44"
                                        Header="Lmt+"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF424242" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLimitPositive}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFEF5350" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  负限位  -->
                                    <DataGridTemplateColumn
                                        Width="44"
                                        Header="Lmt-"
                                        IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF424242" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLimitNegative}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFEF5350" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Rectangle Grid.Column="1" Fill="#FF3A3A3A" />
                            <Grid Grid.Column="2" Background="#FF242424">
                                <!--  未选中时提示  -->
                                <TextBlock
                                    x:Name="PART_NoSelection"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#FF555555"
                                    Text="← 选择一个轴"
                                    Visibility="Collapsed" />

                                <!--  选中后操作面板  -->
                                <ScrollViewer
                                    x:Name="PART_DetailPanel"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!--  轴名 + 状态  -->
                                            <RowDefinition Height="36" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  位置显示  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  Jog速度  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  控制按钮  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  定位区  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  Jog 按钮  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  分隔  -->
                                            <RowDefinition Height="1" />
                                            <!--  状态指示  -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  轴名 + 状态灯  -->
                                        <Border
                                            Grid.Row="0"
                                            Padding="12,0"
                                            Background="#FF252525">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse
                                                    Grid.Column="0"
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,6,0"
                                                    Fill="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusColorConverter}}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="5"
                                                            Opacity="0.9"
                                                            ShadowDepth="0"
                                                            Color="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusColorConverter}}" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FFFAFAFA"
                                                    Text="{Binding SelectedAxis.AxisName, RelativeSource={RelativeSource TemplatedParent}}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusColorConverter}}"
                                                    Text="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusTextConverter}}" />
                                            </Grid>
                                        </Border>

                                        <Rectangle Grid.Row="1" Fill="#FF3A3A3A" />

                                        <!--  位置显示  -->
                                        <Border
                                            Grid.Row="2"
                                            Padding="0"
                                            Background="#FF181818">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  左側彩色监規条  -->
                                                <Border Grid.Column="0" Background="#FF1565C0" />
                                                <StackPanel Grid.Column="1" Margin="10,10,12,10">
                                                    <!--  指令脉冲位置  -->
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="#FF607D8B"
                                                        Text="Pulse Position" />
                                                    <StackPanel Margin="0,2,0,8" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="{TemplateBinding FontSize}"
                                                            FontWeight="Bold"
                                                            Foreground="#FF64B5F6"
                                                            Text="{Binding SelectedAxis.PulsePosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionFormatConverter}}" />
                                                        <TextBlock
                                                            Margin="5,0,0,2"
                                                            VerticalAlignment="Bottom"
                                                            FontSize="11"
                                                            Foreground="#FF546E7A"
                                                            Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </StackPanel>
                                                    <!--  编码器反馈位置  -->
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="#FF607D8B"
                                                        Text="Encoder Position" />
                                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="{TemplateBinding FontSize}"
                                                            FontWeight="Bold"
                                                            Foreground="#FF80CBC4"
                                                            Text="{Binding SelectedAxis.EncoderPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionFormatConverter}}" />
                                                        <TextBlock
                                                            Margin="5,0,0,2"
                                                            VerticalAlignment="Bottom"
                                                            FontSize="11"
                                                            Foreground="#FF546E7A"
                                                            Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Rectangle Grid.Row="3" Fill="#FF3A3A3A" />

                                        <!--  Jog 速度  -->
                                        <Border Grid.Row="4" Padding="0">
                                            <StackPanel>
                                                <Border
                                                    Padding="12,4"
                                                    Background="#FF1F1F1F"
                                                    BorderBrush="#FF2D2D2D"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF546E7A"
                                                        Text="JOG" />
                                                </Border>
                                                <Grid Margin="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#FF757575"
                                                        Text="Speed" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        Padding="4,3"
                                                        HorizontalContentAlignment="Right"
                                                        VerticalContentAlignment="Center"
                                                        Background="#FF1A1A1A"
                                                        BorderBrush="#FF3A3A3A"
                                                        CaretBrush="#FFDEDEDE"
                                                        FontFamily="Consolas"
                                                        Foreground="#FFDEDEDE"
                                                        Text="{Binding JogSpeed, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="#FF757575"
                                                        Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Grid.Row="5" Fill="#FF3A3A3A" />

                                        <!--  控制按钮  -->
                                        <Border Grid.Row="6" Padding="0">
                                            <StackPanel>
                                                <Border
                                                    Padding="12,4"
                                                    Background="#FF1F1F1F"
                                                    BorderBrush="#FF2D2D2D"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF546E7A"
                                                        Text="CONTROL" />
                                                </Border>
                                                <Grid Margin="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="4" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  使能  -->
                                                    <Button
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Height="30"
                                                        Background="{Binding SelectedAxis.IsServoOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServoOnColorConverter}}"
                                                        BorderBrush="Transparent"
                                                        Command="{TemplateBinding ServoOnCommand}"
                                                        CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Cursor="Hand"
                                                        Foreground="White">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Kind="Power" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding SelectedAxis.IsServoOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServoOnTextConverter}}" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!--  急停  -->
                                                    <Button
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Height="30"
                                                        Background="#FFB71C1C"
                                                        BorderBrush="Transparent"
                                                        Command="{TemplateBinding EmergencyStopCommand}"
                                                        CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Cursor="Hand"
                                                        Foreground="White"
                                                        ToolTip="急停">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Kind="AlertOctagon" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Text="急停" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!--  报警复位  -->
                                                    <Button
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Height="30"
                                                        Background="#FFE65100"
                                                        BorderBrush="Transparent"
                                                        Command="{TemplateBinding AlarmResetCommand}"
                                                        CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Cursor="Hand"
                                                        Foreground="White"
                                                        ToolTip="报警复位">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Kind="AlarmOff" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Text="复位" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!--  回原点  -->
                                                    <Button
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        Height="30"
                                                        Background="#FF4527A0"
                                                        BorderBrush="Transparent"
                                                        Command="{TemplateBinding HomeCommand}"
                                                        CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Cursor="Hand"
                                                        Foreground="White"
                                                        ToolTip="原点回归">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Kind="HomeImportOutline" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Text="回零" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Grid.Row="7" Fill="#FF3A3A3A" />

                                        <!--  定位区  -->
                                        <Border Grid.Row="8" Padding="0">
                                            <StackPanel>
                                                <Border
                                                    Padding="12,4"
                                                    Background="#FF1F1F1F"
                                                    BorderBrush="#FF2D2D2D"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF546E7A"
                                                        Text="MOVE" />
                                                </Border>
                                                <StackPanel Margin="12,8">

                                                    <!--  绝对定位行  -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Width="28"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="ABS" />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Padding="4,2"
                                                            HorizontalContentAlignment="Right"
                                                            VerticalContentAlignment="Center"
                                                            Background="#FF1A1A1A"
                                                            BorderBrush="#FF3A3A3A"
                                                            CaretBrush="#FFDEDEDE"
                                                            FontFamily="Consolas"
                                                            Foreground="#FFDEDEDE"
                                                            Text="{Binding TargetPosition, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                        <Button
                                                            Grid.Column="4"
                                                            Width="44"
                                                            Height="24"
                                                            Background="#FF1565C0"
                                                            BorderBrush="Transparent"
                                                            Command="{TemplateBinding MoveAbsoluteCommand}"
                                                            CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                            Cursor="Hand"
                                                            Foreground="White">
                                                            <TextBlock FontSize="11" Text="移动" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  相对定位行  -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Width="28"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="REL" />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Padding="4,2"
                                                            HorizontalContentAlignment="Right"
                                                            VerticalContentAlignment="Center"
                                                            Background="#FF1A1A1A"
                                                            BorderBrush="#FF3A3A3A"
                                                            CaretBrush="#FFDEDEDE"
                                                            FontFamily="Consolas"
                                                            Foreground="#FFDEDEDE"
                                                            Text="{Binding RelativeDistance, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                        <Button
                                                            Grid.Column="4"
                                                            Width="44"
                                                            Height="24"
                                                            Background="#FF2E7D32"
                                                            BorderBrush="Transparent"
                                                            Command="{TemplateBinding MoveRelativeCommand}"
                                                            CommandParameter="{Binding SelectedAxis, RelativeSource={RelativeSource TemplatedParent}}"
                                                            Cursor="Hand"
                                                            Foreground="White">
                                                            <TextBlock FontSize="11" Text="移动" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  移动速度  -->
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Width="28"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="SPD" />
                                                        <TextBox
                                                            Grid.Column="1"
                                                            Padding="4,2"
                                                            HorizontalContentAlignment="Right"
                                                            VerticalContentAlignment="Center"
                                                            Background="#FF1A1A1A"
                                                            BorderBrush="#FF3A3A3A"
                                                            CaretBrush="#FFDEDEDE"
                                                            FontFamily="Consolas"
                                                            Foreground="#FFDEDEDE"
                                                            Text="{Binding MoveSpeed, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="#FF757575"
                                                            Text="{Binding SelectedAxis.PositionUnit, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Grid.Row="9" Fill="#FF3A3A3A" />

                                        <!--  Jog 按钮  -->
                                        <Border Grid.Row="10" Padding="0">
                                            <StackPanel>
                                                <Border
                                                    Padding="12,4"
                                                    Background="#FF1F1F1F"
                                                    BorderBrush="#FF2D2D2D"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF546E7A"
                                                        Text="JOG" />
                                                </Border>
                                                <Grid Margin="12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        x:Name="PART_JogNegativeButton"
                                                        Grid.Column="0"
                                                        Height="40"
                                                        Background="#FF263238"
                                                        BorderBrush="#FF37474F"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Foreground="#FF90A4AE"
                                                        ToolTip="Jog 负向（按住）">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon
                                                                Width="16"
                                                                Height="16"
                                                                VerticalAlignment="Center"
                                                                Kind="ChevronLeft" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontWeight="Bold"
                                                                Text="JOG-" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_JogPositiveButton"
                                                        Grid.Column="2"
                                                        Height="40"
                                                        Background="#FF263238"
                                                        BorderBrush="#FF37474F"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Foreground="#FF90A4AE"
                                                        ToolTip="Jog 正向（按住）">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontWeight="Bold"
                                                                Text="JOG+" />
                                                            <materialDesign:PackIcon
                                                                Width="16"
                                                                Height="16"
                                                                VerticalAlignment="Center"
                                                                Kind="ChevronRight" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Grid.Row="11" Fill="#FF3A3A3A" />

                                        <!--  状态指示区  -->
                                        <Border Grid.Row="12" Padding="0">
                                            <StackPanel>
                                                <Border
                                                    Padding="12,4"
                                                    Background="#FF1F1F1F"
                                                    BorderBrush="#FF2D2D2D"
                                                    BorderThickness="0,0,0,1">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FF546E7A"
                                                        Text="STATUS" />
                                                </Border>
                                                <StackPanel Margin="12,8" Orientation="Vertical">

                                                    <!--  Servo  -->
                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="7"
                                                            Height="7"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding SelectedAxis.IsServoOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServoOnColorConverter}}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="#FF9E9E9E"
                                                            Text="Servo" />
                                                        <TextBlock
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding SelectedAxis.IsServoOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServoOnColorConverter}}"
                                                            Text="{Binding SelectedAxis.IsServoOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServoOnTextConverter}}" />
                                                    </StackPanel>

                                                    <!--  轴状态  -->
                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="7"
                                                            Height="7"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusColorConverter}}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="#FF9E9E9E"
                                                            Text="State" />
                                                        <TextBlock
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusColorConverter}}"
                                                            Text="{Binding SelectedAxis.AxisStatus, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AxisStatusTextConverter}}" />
                                                    </StackPanel>

                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedAxis, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PART_DetailPanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_NoSelection" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:IOInputMonitor}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IOInputMonitor}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="12,7"
                                Background="#FF1F1F1F"
                                BorderBrush="#FF2D2D2D"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Margin="0,0,9,0"
                                            Background="#FF2196F3"
                                            CornerRadius="2" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontWeight="SemiBold"
                                            Foreground="#FF90A4AE"
                                            Text="{TemplateBinding Title}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="#22FFFFFF"
                                        CornerRadius="3">
                                        <TextBlock Foreground="#FF546E7A" Text="READ ONLY" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="6,6,6,4" ItemsSource="{TemplateBinding PointsSource}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  每个磁贴：固定宽度，圆点+CH号+名称  -->
                                            <Border
                                                Width="90"
                                                Margin="3,3"
                                                Padding="6,5"
                                                CornerRadius="4"
                                                ToolTip="{Binding PointName}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FF242424" />
                                                        <Setter Property="BorderBrush" Value="#FF333333" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#1A4CAF50" />
                                                                <Setter Property="BorderBrush" Value="#554CAF50" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <!--  LED 圆点  -->
                                                    <Ellipse
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,0,4"
                                                        HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FF383838" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Fill" Value="#FF4CAF50" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <!--  名称  -->
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FF757575" />
                                                                <Setter Property="Text" Value="{Binding PointName}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFCFD8DC" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        IOOutputMonitor — DO 输出状态显示与控制控件
        磁贴布局：圆点 + 名称 + 拨动开关，WrapPanel 自动换行
    -->
    <Style TargetType="{x:Type local:IOOutputMonitor}">
        <Setter Property="Background" Value="#FF1E1E1E" />
        <Setter Property="BorderBrush" Value="#FF3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IOOutputMonitor}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="12,7"
                                Background="#FF1F1F1F"
                                BorderBrush="#FF2D2D2D"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Width="3"
                                            Margin="0,0,9,0"
                                            Background="#FFFF9800"
                                            CornerRadius="2" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontWeight="SemiBold"
                                            Foreground="#FF90A4AE"
                                            Text="{TemplateBinding Title}" />
                                    </StackPanel>
                                    <Border
                                        x:Name="lockBadge"
                                        Grid.Column="1"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="#33F44336"
                                        BorderBrush="#66F44336"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FFF44336"
                                            Text="&#x2298; 已锁定" />
                                    </Border>
                                    <Border
                                        x:Name="editBadge"
                                        Grid.Column="1"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="#22FFFFFF"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FF546E7A"
                                            Text="MANUAL" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="6,6,6,4" ItemsSource="{TemplateBinding PointsSource}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  每个磁贴：圆点+名称+拨动开关  -->
                                            <Border
                                                Width="90"
                                                Margin="3,3"
                                                Padding="6,5"
                                                CornerRadius="4"
                                                ToolTip="{Binding PointName}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FF242424" />
                                                        <Setter Property="BorderBrush" Value="#FF333333" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#1A4CAF50" />
                                                                <Setter Property="BorderBrush" Value="#554CAF50" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <!--  LED 圆点  -->
                                                    <Ellipse
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,0,4"
                                                        HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FF383838" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Fill" Value="#FF4CAF50" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <!--  名称  -->
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FF757575" />
                                                                <Setter Property="Text" Value="{Binding PointName}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFCFD8DC" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!--  拨动开关  -->
                                                    <Button
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding ToggleOutputCommand, RelativeSource={RelativeSource AncestorType={x:Type local:IOOutputMonitor}}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        IsEnabled="{Binding IsOperationEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:IOOutputMonitor}}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    x:Name="track"
                                                                    Width="36"
                                                                    Height="18"
                                                                    Background="#FF3A3A3A"
                                                                    CornerRadius="9">
                                                                    <Grid Margin="2">
                                                                        <Ellipse
                                                                            x:Name="knob"
                                                                            Width="14"
                                                                            Height="14"
                                                                            HorizontalAlignment="Left"
                                                                            Fill="#FF6E6E6E" />
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="track" Property="Background" Value="#FF388E3C" />
                                                                        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                                                        <Setter TargetName="knob" Property="Fill" Value="#FFFFFFFF" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="track" Property="Opacity" Value="0.8" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="track" Property="Opacity" Value="0.6" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="track" Property="Opacity" Value="0.3" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOperationEnabled" Value="False">
                            <Setter TargetName="lockBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="editBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
