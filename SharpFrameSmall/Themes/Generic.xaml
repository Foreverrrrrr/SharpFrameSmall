<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SharpFrameSmall.Views.SharpStyle"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:param="clr-namespace:SharpFrameSmall.Structure.Parameter">

    <local:DrawingModeConverter x:Key="DrawingModeConverter" />
    <local:InvertBoolConverter x:Key="InvertBoolConverter" />
    <local:EditModeToReadOnlyConverter x:Key="EditModeToReadOnlyConverter" />
    <local:EditModeToVisibilityConverter x:Key="EditModeToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:AxisStatusTextConverter x:Key="AxisStatusTextConverter" />
    <local:AxisStatusColorConverter x:Key="AxisStatusColorConverter" />
    <local:ServoOnTextConverter x:Key="ServoOnTextConverter" />
    <local:ServoOnColorConverter x:Key="ServoOnColorConverter" />
    <local:PositionFormatConverter x:Key="PositionFormatConverter" />
    <local:IOActiveColorConverter x:Key="IOActiveColorConverter" />
    <local:IOActiveTextConverter x:Key="IOActiveTextConverter" />
    <local:IOOutputButtonTextConverter x:Key="IOOutputButtonTextConverter" />
    <local:IOOutputButtonColorConverter x:Key="IOOutputButtonColorConverter" />

    <Style x:Key="MaterialDesignToolRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFAFAFA" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF4CAF50" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#FF81C784" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#66FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="IconBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="#FFE0E0E0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="#FFD0D0D0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GenericNotification}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GenericNotification}">
                    <StackPanel Orientation="Vertical">
                        <ItemsControl ItemsSource="{TemplateBinding IsNotice}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplateSelector>
                                <local:NotificationTemplateSelector>
                                    <local:NotificationTemplateSelector.InfoTemplate>
                                        <DataTemplate>
                                            <local:Notification_Info
                                                ID="{Binding ID}"
                                                Message="{Binding Message}"
                                                MessageTime="{Binding MessageTime}" />
                                        </DataTemplate>
                                    </local:NotificationTemplateSelector.InfoTemplate>
                                    <local:NotificationTemplateSelector.WarningTemplate>
                                        <DataTemplate>
                                            <local:Notification_Warning
                                                ID="{Binding ID}"
                                                Message="{Binding Message}"
                                                MessageTime="{Binding MessageTime}" />
                                        </DataTemplate>
                                    </local:NotificationTemplateSelector.WarningTemplate>
                                    <local:NotificationTemplateSelector.ErrorTemplate>
                                        <DataTemplate>
                                            <local:Notification_Error
                                                CloseCommand="{Binding Delete}"
                                                ID="{Binding ID}"
                                                Message="{Binding Message}"
                                                MessageTime="{Binding MessageTime}" />
                                        </DataTemplate>
                                    </local:NotificationTemplateSelector.ErrorTemplate>
                                    <local:NotificationTemplateSelector.FatalTemplate>
                                        <DataTemplate>
                                            <local:Notification_Fatal
                                                CloseCommand="{Binding Delete}"
                                                ID="{Binding ID}"
                                                Message="{Binding Message}"
                                                MessageTime="{Binding MessageTime}" />
                                        </DataTemplate>
                                    </local:NotificationTemplateSelector.FatalTemplate>
                                </local:NotificationTemplateSelector>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:Notification_Info}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Notification_Info}">
                    <Border
                        Width="300"
                        MinHeight="65"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#FF848484"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Width"
                                            From="0.0"
                                            To="300"
                                            Duration="0:0:0.3" />
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.0"
                                            To="1.0"
                                            Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="35"
                                Height="35"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="#FF4CE807"
                                Kind="BellRing" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    MaxWidth="250"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Black"
                                    Text="{TemplateBinding Message}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    MaxWidth="160"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="Black"
                                    Text="{TemplateBinding MessageTime}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
