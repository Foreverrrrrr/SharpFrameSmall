<UserControl
    x:Class="SharpFrameSmall.Views.MotionDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SharpFrameSmall.Views.SharpStyle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="900"
    d:DesignWidth="1870"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:AxisMonitor
            Grid.Column="0"
            VerticalAlignment="Stretch"
            AlarmResetCommand="{Binding AlarmResetCommand}"
            AxesSource="{Binding Axes}"
            EmergencyStopCommand="{Binding EStopCommand}"
            FontSize="15"
            HomeCommand="{Binding HomeCommand}"
            JogNegativeStartCommand="{Binding JogNegStartCommand}"
            JogNegativeStopCommand="{Binding JogNegStopCommand}"
            JogPositiveStartCommand="{Binding JogPosStartCommand}"
            JogPositiveStopCommand="{Binding JogPosStopCommand}"
            JogSpeed="{Binding JogSpeed, Mode=TwoWay}"
            MoveAbsoluteCommand="{Binding MoveAbsCommand}"
            MoveRelativeCommand="{Binding MoveRelCommand}"
            MoveSpeed="{Binding MoveSpeed, Mode=TwoWay}"
            RelativeDistance="{Binding RelativeDistance, Mode=TwoWay}"
            SelectedAxis="{Binding SelectedAxis, Mode=TwoWay}"
            ServoOnCommand="{Binding ServoOnCommand}"
            TargetPosition="{Binding TargetPosition, Mode=TwoWay}" />
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <local:IOInputMonitor
                Title="输入"
                FontSize="12"
                PointsSource="{Binding DiPoints}" />

            <local:IOOutputMonitor
                Title="输出"
                FontSize="12"
                IsOperationEnabled="{Binding IsManualMode}"
                PointsSource="{Binding DoPoints}"
                ToggleOutputCommand="{Binding ToggleDoCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
