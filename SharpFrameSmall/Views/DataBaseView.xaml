<UserControl
    x:Class="SharpFrameSmall.Views.DataBaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Margin="5"
    d:DesignHeight="900"
    d:DesignWidth="1870"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Height="70"
                    Margin="25,0,0,0"
                    Orientation="Horizontal">
                    <DatePicker
                        Width="130"
                        Height="40"
                        Background="White"
                        BorderBrush="Black"
                        FontSize="16"
                        Foreground="Black"
                        Language="zh-CN"
                        SelectedDate="{Binding Time, Mode=TwoWay}">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True" />
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <Button
                        Height="40"
                        Margin="15,0,0,0"
                        Content="{DynamicResource QRCodeInquiry}"
                        FontSize="16"
                        Foreground="Black" />
                    <Button
                        Height="40"
                        Margin="15,0,0,0"
                        Command="{Binding DatabaseTimeQuery}"
                        Content="{DynamicResource TimePeriodQuery}"
                        FontSize="16"
                        Foreground="Black" />
                    <Button
                        Height="40"
                        Margin="15,0,0,0"
                        Command="{Binding Export}"
                        CommandParameter="{Binding DatabaseView}"
                        Content="{DynamicResource ExportToExcel}"
                        Foreground="Black" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="5">
                    <DataGrid
                        x:Name="datagrid"
                        AutoGenerateColumns="True"
                        FontSize="16"
                        IsReadOnly="True"
                        ItemsSource="{Binding DatabaseView}" />
                </Grid>
                <Border
                    x:Name="LoadingMask"
                    Grid.Row="1"
                    Grid.RowSpan="1"
                    Grid.ColumnSpan="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="3"
                    Background="#993C3B3B"
                    CornerRadius="0"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar
                            Width="100"
                            Height="100"
                            IsIndeterminate="True"
                            Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="50">
                            <ProgressBar.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="StrokeThickness" Value="6" />
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{DynamicResource loading}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
