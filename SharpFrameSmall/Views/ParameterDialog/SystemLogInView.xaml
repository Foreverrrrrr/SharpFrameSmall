<UserControl
    x:Class="SharpFrameSmall.Views.SystemLogInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SharpFrameSmall.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Width="450"
    Height="610"
    Padding="0"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{x:Null}">
    <UserControl.Resources>
        <local:PermissionToEnabledConverter x:Key="PermissionEnabled" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Login_button}" />
    </UserControl.InputBindings>
    <Border Margin="0" CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="5"
                Direction="10"
                Opacity="0.1"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.8*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Border CornerRadius="15,15,0,0" />

            <Grid Grid.Row="0">
                <Grid>
                    <FrameworkElement.Resources>
                        <local:TimeSpanIncreaser
                            x:Key="BeginTimeIncreaser"
                            Start="-0:0:2"
                            Step="-0:0:1" />
                        <local:DurationIncreaser
                            x:Key="DurationIncreaser"
                            Start="0:0:7"
                            Step="0:0:3" />
                        <Style TargetType="ContentControl">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Grid>
                                            <FrameworkElement.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard BeginTime="{Binding Next, Source={StaticResource BeginTimeIncreaser}}" RepeatBehavior="Forever">
                                                            <PointAnimation
                                                                Storyboard.TargetName="Path"
                                                                Storyboard.TargetProperty="RenderTransformOrigin"
                                                                From="0.375,0.5"
                                                                To="0.625,0.5"
                                                                Duration="{Binding Next, Source={StaticResource DurationIncreaser}}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </FrameworkElement.Triggers>
                                            <Path
                                                x:Name="Path"
                                                Data="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"
                                                Fill="#FF8AFF05"
                                                Stretch="Fill">
                                                <Path.LayoutTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Path.LayoutTransform>
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </FrameworkElement.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.65*" />
                        <RowDefinition Height="0.35*" />
                    </Grid.RowDefinitions>
                    <FrameworkElement.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <PointAnimation
                                        RepeatBehavior="Forever"
                                        Storyboard.TargetName="Brush"
                                        Storyboard.TargetProperty="Center"
                                        From="-3,.5"
                                        To="4,.5"
                                        Duration="0:0:2" />
                                    <PointAnimation
                                        RepeatBehavior="Forever"
                                        Storyboard.TargetName="Brush"
                                        Storyboard.TargetProperty="GradientOrigin"
                                        From="-3,.5"
                                        To="4,.5"
                                        Duration="0:0:2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </FrameworkElement.Triggers>
                    <TextBlock
                        x:Name="TextBlock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="SegoeUI"
                        FontSize="50"
                        Foreground="#FF311F1F"
                        RenderTransformOrigin="0.5,0.5"
                        Text="{Binding Title}">
                        <TextBlock.OpacityMask>
                            <RadialGradientBrush x:Name="Brush" Center="-3,.5" GradientOrigin="-3,.5" RadiusX=".2" RadiusY="2">
                                <GradientStop Color="#2000" />
                                <GradientStop Offset=".5" Color="#6000" />
                                <GradientStop Offset="1" Color="Black" />
                            </RadialGradientBrush>
                        </TextBlock.OpacityMask>
                    </TextBlock>
                    <Grid Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="2" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <ContentControl Opacity=".7" />
                        <ContentControl Margin="0,10,0,0" Opacity=".5" />
                        <ContentControl Margin="0,20,0,0" Opacity=".3" />
                        <ContentControl Margin="0,30,0,0" />
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="75" />
                    <RowDefinition Height="75" />
                    <RowDefinition Height="75" />
                    <RowDefinition Height="75" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="1"
                    Width="190"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Margin="0,3,10,0"
                        Kind="Account" />
                    <ComboBox
                        Width="130"
                        HorizontalContentAlignment="Center"
                        Panel.ZIndex="1"
                        Background="White"
                        BorderBrush="Black"
                        FontSize="20"
                        IsEnabled="{Binding Upload}"
                        SelectedIndex="0"
                        SelectedValue="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Content">
                        <ComboBoxItem Background="White" Content="Operator" />
                        <ComboBoxItem Background="White" Content="Technician" />
                        <ComboBoxItem Background="White" Content="Engineer" />
                        <ComboBoxItem Background="White" Content="Admin" />
                    </ComboBox>
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Width="190"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Margin="0,3,10,0"
                        Kind="Key" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Width="130"
                        local:PasswordBoxHelper.Attach="True"
                        local:PasswordBoxHelper.Password="{Binding PassWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        BorderBrush="Black"
                        CaretBrush="Black"
                        FontSize="20"
                        IsEnabled="{Binding Upload}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Width="230"
                    Margin="0,30,0,0"
                    VerticalAlignment="Center"
                    Cursor=""
                    Orientation="Horizontal">
                    <Button
                        Width="230"
                        Height="45"
                        Background="#FF3C3C3C"
                        BorderBrush="{x:Null}"
                        Command="{Binding Login_button}"
                        FontSize="23"
                        Foreground="White"
                        IsEnabled="{Binding Upload}"
                        Style="{StaticResource MaterialDesignRaisedLightButton}">
                        <TextBlock Text="{DynamicResource Login}" />
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    Width="230"
                    Margin="0,30,0,0"
                    VerticalAlignment="Center"
                    Cursor=""
                    Orientation="Horizontal">
                    <Button
                        Width="230"
                        Height="45"
                        Background="#FFCB2C2C"
                        BorderBrush="{x:Null}"
                        Command="{Binding OutLogin_button}"
                        FontSize="23"
                        Foreground="White"
                        IsEnabled="{Binding CurrentUserLevel, Converter={StaticResource PermissionEnabled}, ConverterParameter=1}"
                        Style="{StaticResource MaterialDesignRaisedLightButton}">
                        <TextBlock Text="{DynamicResource Outlogin}" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Background="White">
                <ProgressBar
                    Height="10"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Foreground="#FFFFF506"
                    IsIndeterminate="{Binding UploadProgressBar}" />
                <ProgressBar
                    Height="10"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Value="{Binding CountDownValue}" />
            </Grid>
            <Grid Grid.Row="3" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="#FFEEEEEE"
                    BorderBrush="{x:Null}"
                    Command="{Binding Administration}"
                    Content="{DynamicResource Administration}"
                    FontWeight="Bold"
                    IsEnabled="{Binding CurrentUserLevel, Converter={StaticResource PermissionEnabled}, ConverterParameter=3}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
