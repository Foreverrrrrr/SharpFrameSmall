<Window
    x:Class="SharpFrameSmall.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SharpFrameSmall.Views.SharpStyle"
    xmlns:local1="clr-namespace:SharpFrameSmall.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Width="{Binding Width}"
    Height="{Binding Height}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local1:PermissionToEnabledConverter x:Key="PermissionEnabled" />
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Close}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="ContentRendered">
            <i:InvokeCommandAction Command="{Binding PageLoadFinish}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <ContentControl
            HorizontalAlignment="Right"
            Panel.ZIndex="1"
            prism:RegionManager.RegionName="SkinRegion"
            Foreground="{x:Null}" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ProgressBar
                    Height="8"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Foreground="#FFE2E2E2"
                    IsIndeterminate="{Binding LoadingBarState}"
                    Orientation="Horizontal" />
            </Grid>
            <Border Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#FF3583EA" CornerRadius="15">
                        <StackPanel>
                            <Border
                                Height="70"
                                Margin="0,20,0,0"
                                CornerRadius="5">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <i:InvokeCommandAction Command="{Binding PermissionCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon
                                            Width="40"
                                            Height="40"
                                            Foreground="Black"
                                            Kind="AccountConvert" />
                                    </Grid>
                                    <Grid
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <TextBlock FontSize="16" Text="{Binding ActiveUser}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="HomeView"
                                Content="{DynamicResource HomeView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="ParameterView"
                                Content="{DynamicResource ParameterView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="MotionDebugView"
                                Content="{DynamicResource DebugView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="DataBaseView"
                                Content="{DynamicResource DataView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="ProduceInfoView"
                                Content="{DynamicResource InfoView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                            <Button
                                Height="70"
                                Margin="0,30,0,0"
                                Command="{Binding VisionSwitching}"
                                CommandParameter="LogView"
                                Content="{DynamicResource LogView}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Style="{StaticResource MaterialDesignFlatLightButton}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3.5*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="1"
                            prism:RegionManager.RegionName="MainRegion"
                            Foreground="{x:Null}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="1"
                            Panel.ZIndex="1"
                            prism:RegionManager.RegionName="ToolRegion"
                            Foreground="{x:Null}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Orientation="Vertical">
                        <local:GenericNotification IsNotice="{Binding IsNotice}" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel
                Grid.Row="2"
                Margin="0,0,3,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ComboBox
                    Height="25"
                    Margin="0,0,10,0"
                    DisplayMemberPath="Display"
                    FontSize="14"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                <TextBlock
                    Height="15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="{Binding VersionTextBlock}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
